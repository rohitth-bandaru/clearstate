# Required
PORT=8080
DB_DRIVER=mysql
# Option 1: single DSN
# DB_DSN=user:password@tcp(host:3306)/clearstatus?parseTime=true&multiStatements=true
# Option 2: build URL from parts (DB_DSN ignored if set)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=clearstatus
JWT_SECRET=your-secret-key

# Optional (required for Google sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional
PRODUCTION=false

# Logging: LOG_LEVEL=debug|info|warn|error (default info), LOG_FORMAT=json|text (default json)
LOG_LEVEL=info
LOG_FORMAT=json
